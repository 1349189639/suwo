# 环境变量示例（复制成 .env.local 使用；真正的 .env* 已被 .gitignore 忽略）
#
# ⚠️ 这三个都是「前端公开值」，会被打进 JS 包里，任何人打开网页都能看到：
#    - 不是密钥，泄露也不构成越权；
#    - 不需要轮换、不需要清理 git 历史；
#    - 加进忽略列表只是防止以后把真密钥误放进来。
#
# 不填也能跑：cloud.v2.ts 里有同样的默认值兜底。

# CloudBase 环境 ID（ap-shanghai）
VITE_CLOUD_ENV=suwo-fitnessapp-d7fn2a359e4760f8

# 环境地域
VITE_CLOUD_REGION=ap-shanghai

# CloudBase 的 publishable key（前端公开标识，非服务端密钥）
VITE_CLOUD_ACCESS_KEY=
