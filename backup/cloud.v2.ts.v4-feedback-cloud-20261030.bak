/**
 * 塑我 · 腾讯云开发 CloudBase 连接层 v2（2026-10-29，v2.2）
 *
 * 与 v1（data/cloud.ts）的区别：
 * - 使用真实完整环境 ID、region、前端 publishable key（accessKey）初始化；
 * - 认证走 v3（supabase-like）API：signInWithPassword / getSession / signOut；
 * - 会话判断只认 auth.getSession() 的 data.session，不再使用已废弃的 getLoginState；
 * - 旧 v1 文件保留不动，本文件为新版本，便于回退对比。
 *
 * 说明：publishable key 是前端公开标识，不是服务端密钥；值从 .env 注入，缺省回退内置。
 */
import cloudbase from '@cloudbase/js-sdk'

/** 完整环境 ID（可公开，不是密钥） */
export const CLOUD_ENV =
  (import.meta.env.VITE_CLOUD_ENV as string | undefined) ?? 'suwo-fitnessapp-d7fn2a359e4760f8'

const REGION = (import.meta.env.VITE_CLOUD_REGION as string | undefined) ?? 'ap-shanghai'
const ACCESS_KEY = (import.meta.env.VITE_CLOUD_ACCESS_KEY as string | undefined) ?? ''

// eslint-disable-next-line @typescript-eslint/no-explicit-any
let cached: any = null

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function app(): any {
  if (!cached) {
    cached = cloudbase.init({
      env: CLOUD_ENV,
      region: REGION,
      accessKey: ACCESS_KEY,
      persistence: 'local',
      auth: { detectSessionInUrl: true },
    })
  }
  return cached
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function auth(): any {
  return app().auth({ persistence: 'local' })
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function db(): any {
  return app().database()
}

export interface CloudUser {
  uid: string
  email?: string
  username?: string
}

/** 从任意错误对象里抠出可读文本，避免页面出现 [object Object] */
function describeRaw(e: unknown): string {
  if (e == null) return '未知错误'
  if (e instanceof Error) return e.message || String(e)
  if (typeof e === 'string') return e
  const obj = e as Record<string, any>
  const inner = obj.error
  const parts: string[] = []
  if (obj.code) parts.push(`code=${obj.code}`)
  if (obj.message) parts.push(obj.message)
  if (inner && typeof inner === 'object') {
    if (inner.code) parts.push(`code=${inner.code}`)
    if (inner.message) parts.push(inner.message)
  } else if (inner) {
    parts.push(String(inner))
  }
  if (parts.length) return parts.join('；')
  try {
    return JSON.stringify(e)
  } catch {
    return String(e)
  }
}

/** 把 SDK / 网关报错翻译成人话，并指出该去哪一项排查 */
export function explainError(e: unknown): string {
  const raw = describeRaw(e)
  const s = raw.toLowerCase()

  if (s.includes('cors') || s.includes('domain') || s.includes('origin') || s.includes('非法域名') || s.includes('安全域名') || s.includes('安全来源')) {
    return `页面来源不在白名单（CORS）：当前网页域名未被云开发放行。请确认页面运行在已授权的托管域名上。原始错误：${raw}`
  }
  if (s.includes('401') || s.includes('unauthorized') || s.includes('未登录') || s.includes('登录态') || s.includes('session')) {
    return `当前未登录或登录态已失效：先完成密码登录再读写云端数据。原始错误：${raw}`
  }
  if (s.includes('permission') || s.includes('权限') || s.includes('denied') || s.includes('forbidden')) {
    return `数据库权限不足：集合 appdata 设为「仅创建者可读写」，只能读写本人数据。原始错误：${raw}`
  }
  if (s.includes('password') || s.includes('密码') || s.includes('invalid credentials') || s.includes('账号或密码')) {
    return `账号或密码不正确。原始错误：${raw}`
  }
  if (s.includes('network') || s.includes('timeout') || s.includes('fetch') || s.includes('failed to fetch')) {
    return `网络不通：检查手机/电脑联网，或当前域名被拦截。原始错误：${raw}`
  }
  return raw
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
function toUser(sessionUser: any): CloudUser | null {
  if (!sessionUser) return null
  const uid = sessionUser.id ?? sessionUser.uid ?? sessionUser.sub ?? sessionUser.user_metadata?.uid
  if (!uid) return null
  const rawEmail = sessionUser.email
  const rawUsername = sessionUser.username ?? sessionUser.user_metadata?.username
  return {
    uid: String(uid),
    // 空字符串归一为 undefined：网关可能把未设置的 email 返回成 ""，避免 ?? 兜底失效
    email: rawEmail || undefined,
    username: rawUsername || undefined,
  }
}

/** 从登录/会话响应里逐层找 user 对象 */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
function pickUser(res: any): CloudUser | null {
  if (!res) return null
  return toUser(res.data?.user) ?? toUser(res.data?.session?.user) ?? toUser(res.session?.user)
}

/** 密码登录（用户名 / 邮箱 二选一标识）。先按用户名尝试，看起来是邮箱时按邮箱尝试。 */
export async function signIn(account: string, password: string): Promise<CloudUser> {
  const a = auth()
  const name = account.trim()
  const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(name)

  let res: any
  if (isEmail) {
    res = await a.signInWithPassword({ email: name, password })
    if (res?.error) res = await a.signInWithPassword({ username: name, password })
  } else {
    res = await a.signInWithPassword({ username: name, password })
  }

  if (res?.error) throw new Error(describeRaw(res.error))

  const user = pickUser(res)
  if (!user) throw new Error('登录成功但没有拿到用户信息，请检查登录方式配置')
  return user
}

export async function signOut(): Promise<void> {
  const res = await auth().signOut()
  if (res?.error) throw new Error(describeRaw(res.error))
}

/** 已登录状态下修改密码（凭旧密码校验，不依赖邮件通道）。 */
export async function changePassword(oldPassword: string, newPassword: string): Promise<void> {
  const a = auth()
  const user = a.currentUser
  if (!user) throw new Error('当前未登录，无法修改密码')
  let res: any
  try {
    res = await user.updatePassword(newPassword, oldPassword)
  } catch (e) {
    throw new Error(describeRaw(e))
  }
  // SDK 两种返回形态：直接抛错，或返回 { error }
  if (res && res.error) throw new Error(describeRaw(res.error))
}

/** 删除当前云端账号（需输入密码二次确认）。删除成功后本地会话由调用方清理。 */
export async function deleteCloudAccount(password: string): Promise<void> {
  // 1) 先在会话仍然有效、本人权限允许的前提下删掉 appdata 整档，避免只删 auth 用户、文档残留。
  const user = await currentUser()
  if (user) {
    await deleteCloudDoc(user.uid)
  }

  // 2) 再删除云端 auth 用户；顺序不可颠倒——删号后会话失效，无权再访问数据库。
  const a = auth()
  let res: any
  try {
    res = await a.deleteUser({ password })
  } catch (e) {
    throw new Error(describeRaw(e))
  }
  if (res && res.error) throw new Error(describeRaw(res.error))
}

/**
 * 前端自助注册（用户名 + 密码）。
 * ⚠ 当前云端仅开启 usernamePassword，未开通邮件/短信验证码通道：按官方约定注册必须完成验证码，
 * 此方法作为预留封装，界面暂不开放；待开通邮件 OTP 后再接入 signUp + data.verifyOtp 流程。
 */
export async function signUpCloud(username: string, password: string): Promise<CloudUser> {
  const res = await auth().signUp({ username, password })
  if (res?.error) throw new Error(describeRaw(res.error))
  const user = pickUser(res)
  if (!user) throw new Error('注册未完成：当前环境未开放前端自助注册，请联系管理员创建账号')
  return user
}

/** 监听登录态变化（SIGNED_IN / SIGNED_OUT / INITIAL_SESSION 等），返回取消订阅函数。 */
export function watchSession(cb: (event: string, user: CloudUser | null) => void): () => void {
  const a = auth()
  const sub = a.onAuthStateChange((event: string, session: any) => {
    cb(event, session?.user ? toUser(session.user) : null)
  })
  return () => {
    try {
      sub?.data?.subscription?.unsubscribe?.()
    } catch {
      /* 忽略取消订阅异常 */
    }
  }
}

/** 当前登录用户；未登录返回 null。只认 getSession 的真实会话。 */
export async function currentUser(): Promise<CloudUser | null> {
  const res = await auth().getSession()
  if (res?.error) return null
  return pickUser(res)
}

/** 诊断：把 getSession 原始结构（脱敏 token）序列化成 JSON，用于核对用户字段层级。 */
export async function sessionDebug(): Promise<string> {
  const res = await auth().getSession()
  const clone = JSON.parse(JSON.stringify(res ?? {}))
  const scrub = (u: Record<string, unknown> | null | undefined) => {
    if (u && typeof u === 'object') {
      for (const k of ['access_token', 'refresh_token', 'token']) {
        if (k in u) u[k] = '***'
      }
    }
  }
  try {
    const session = clone?.data?.session ?? clone?.session
    const user = clone?.data?.user ?? session?.user ?? clone?.data?.session?.user
    scrub(session)
    scrub(user)
    return JSON.stringify({ topKeys: Object.keys(clone), dataKeys: clone?.data ? Object.keys(clone.data) : [], session, user }, null, 2)
  } catch (e) {
    return '序列化失败：' + describeRaw(e)
  }
}

/** 文档不存在时返回 null，而不是把"没数据"当成错误抛出 */
function isNotFound(e: unknown): boolean {
  const raw = describeRaw(e).toLowerCase()
  return raw.includes('not found') || raw.includes('404') || raw.includes('不存在') || raw.includes('document not exist')
}

/** 读整档数据（当前阶段：一份文档，后续再拆表） */
export async function loadDoc(uid: string): Promise<Record<string, unknown> | null> {
  try {
    const res = await db().collection('appdata').doc(uid).get()
    const d = res?.data
    const row = Array.isArray(d) ? d[0] : d
    const doc = row?.doc
    return doc && typeof doc === 'object' ? (doc as Record<string, unknown>) : null
  } catch (e) {
    if (isNotFound(e)) return null
    throw e
  }
}

export async function saveDoc(uid: string, doc: unknown): Promise<void> {
  await db()
    .collection('appdata')
    .doc(uid)
    .set({ doc, updated_at: Date.now() })
}

/**
 * 删除当前用户在 appdata 的整档文档。
 * 文档不存在时视为成功（已被清掉）；其它权限/网络错误向上抛出。
 * 必须在账号（auth 用户）被删除之前调用：删除用户后会话失效，本人权限不再允许删库。
 */
export async function deleteCloudDoc(uid: string): Promise<void> {
  try {
    await db().collection('appdata').doc(uid).remove()
  } catch (e) {
    if (isNotFound(e)) return
    throw e
  }
}

export interface CheckResult {
  name: string
  ok: boolean
  detail: string
}

/** 连接自检：逐项报告卡在哪一层。未登录时不强行测数据库读写。 */
export async function selfCheck(): Promise<CheckResult[]> {
  const out: CheckResult[] = []

  // 1. SDK 初始化
  try {
    app()
    out.push({ name: 'SDK 初始化', ok: true, detail: `环境 ${CLOUD_ENV}（${REGION}）` })
  } catch (e) {
    out.push({ name: 'SDK 初始化', ok: false, detail: explainError(e) })
    return out
  }

  // 2. 登录接口是否存在
  try {
    const a = auth()
    const hasPwd = typeof a.signInWithPassword === 'function'
    const hasSession = typeof a.getSession === 'function'
    out.push({
      name: '密码登录接口',
      ok: hasPwd && hasSession,
      detail: hasPwd ? 'v3 密码登录 / 会话接口可用' : 'SDK 缺少 signInWithPassword 方法',
    })
  } catch (e) {
    out.push({ name: '密码登录接口', ok: false, detail: explainError(e) })
  }

  // 3. 登录态
  let user: CloudUser | null = null
  try {
    user = await currentUser()
    out.push({
      name: '登录态',
      ok: true,
      detail: user ? `已登录 ${user.email || user.username || user.uid}` : '未登录（正常，可在下方试登录）',
    })
  } catch (e) {
    out.push({ name: '登录态', ok: false, detail: explainError(e) })
  }

  // 4. 数据库：仅在已登录后测读取；未登录只提示
  if (!user) {
    out.push({ name: '数据库读写', ok: true, detail: '需登录后检测（仅创建者可读写）' })
    return out
  }

  try {
    const doc = await loadDoc(user.uid)
    out.push({
      name: '数据库读取',
      ok: true,
      detail: doc ? 'appdata 本人文档已读到' : 'appdata 可访问，本人文档暂无数据（首次使用属正常）',
    })
  } catch (e) {
    out.push({ name: '数据库读取', ok: false, detail: explainError(e) })
  }

  return out
}
